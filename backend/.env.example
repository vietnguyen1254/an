# Copy to .env on the server (chmod 600) and fill in. NEVER commit .env.
# Generate secrets with:  openssl rand -base64 36

# --- domain / TLS ---
DOMAIN=api.justin.vn
LETSENCRYPT_EMAIL=you@example.com

# --- postgres ---
POSTGRES_DB=an
POSTGRES_USER=an
POSTGRES_PASSWORD=CHANGE_ME_strong_random

# --- api ---
# host:port is the compose service name; keep in sync with POSTGRES_* above
DATABASE_URL=postgresql://an:CHANGE_ME_strong_random@db:5432/an
JWT_SECRET=CHANGE_ME_random_48_chars
JWT_TTL=30d
# Signs short-lived /media/audio/ links (see nginx/an.conf.template) — keep
# separate from JWT_SECRET so rotating one doesn't invalidate the other.
MEDIA_LINK_SECRET=CHANGE_ME_random_48_chars
RATE_LIMIT_MAX=120
LOG_LEVEL=info

# Path INSIDE the api container (mounted read-only from ./secrets)
FIREBASE_SERVICE_ACCOUNT=/run/secrets/firebase.json

# --- backups ---
BACKUP_SCHEDULE=@daily
BACKUP_KEEP_DAYS=7
BACKUP_KEEP_WEEKS=4
BACKUP_KEEP_MONTHS=6
